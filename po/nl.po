msgid "Welcome to the Heks-Linux power user session"
msgstr "Welkom bij de Heks-Linux power-user-sessie"

msgid "Enter and explore, for the cosmos of computation is yours to command."
msgstr "Ga naar binnen en verken: het universum van de berekening is van jou."

msgid "Capture failed"
msgstr "Vastleggen mislukt"

msgid "missing: %s"
msgstr "ontbreekt: %s"

msgid "missing: a recorder (wl-screenrec or wf-recorder)"
msgstr "ontbreekt: een recorder (wl-screenrec of wf-recorder)"

msgid "missing: an annotation editor (satty, swappy or gimp)"
msgstr "ontbreekt: een annotatie-editor (satty, swappy of gimp)"

msgid "optional: gifski (ffmpeg encodes the GIF without it)"
msgstr "optioneel: gifski (ffmpeg maakt de GIF ook zonder)"

msgid "every capture tool is installed"
msgstr "alle vastlegprogramma's zijn geïnstalleerd"

msgid "install with: maak install-zypper and maak install-nix-packages"
msgstr "installeer met: maak install-zypper en maak install-nix-packages"
