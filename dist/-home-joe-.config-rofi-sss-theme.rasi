* {
  foreground: #e6e1cf;
  background-color: transparent;
  highlight: bold;
  font: "Plus Jakarta Sans 14";
}

window {
  location: center;
  anchor: center;
  transparency: "real";
  width: 45%;
  padding: 24px;
  border: 2px;
  border-color: #ff9940;
  border-radius: 16px;
  background-color: rgba(15, 20, 25, 0.88);
  children: [ mainbox ];
}

mainbox {
  spacing: 12px;
  children: [ inputbar, message, listview ];
}

message {
  border: 0px;
  padding: 6px;
}

inputbar {
  spacing: 8px;
  padding: 12px 16px;
  border-radius: 8px;
  background-color: rgba(19, 23, 33, 0.5);
  text-color: #e6e1cf;
  children: [ prompt, entry, button-close ];
}

button-close {
  action: "kb-cancel";
  str: "  ";
  expand: false;
  text-color: #e6e1cf;
  cursor: pointer;
}

prompt {
  text-color: #ff9940;
}

entry {
  placeholder: "Search...";
  placeholder-color: rgba(230, 225, 207, 0.5);
  text-color: #e6e1cf;
}

listview {
  scrollbar: false;
  cycle: true;
  dynamic: true;
  spacing: 4px;
  lines: 16;
}

element {
  padding: 8px 12px;
  spacing: 12px;
  border-radius: 8px;
  background-color: transparent;
}

element-text {
  text-color: #e6e1cf;
  background-color: transparent;
  vertical-align: 0.5;
}

element-icon {
  size: 32px;
  background-color: transparent;
  vertical-align: 0.5;
}

element selected {
  background-color: #ff9940;
  text-color: #0f1419;
}

