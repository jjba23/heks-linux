// ====== Heks-Linux Niri configuration ======
//
// auto-generated file, DO NOT EDIT!
input {
  keyboard {
    xkb {
      layout "us"
      options "ctrl:nocaps"
    }
    numlock 
  }
  touchpad {
    tap 
  }
  warp-mouse-to-focus 
  focus-follows-mouse max-scroll-amount="0%"
  workspace-auto-back-and-forth 
}
layout {
  background-color "transparent"
  gaps 10
  center-focused-column "never"
  preset-column-widths {
    proportion 0.333333
    proportion 0.5
    proportion 0.666666
  }
  default-column-width {
    proportion 0.666666
  }
  focus-ring {
    width 2
    active-color "#ff9940"
    inactive-color "#131721"
  }
  shadow {
    on 
    draw-behind-window true
    softness 30
    spread 5
    offset x=0 y=5
    color "#0007"
  }
  struts {
    left 5
    right 5
    top 5
    bottom 5
  }
}
hotkey-overlay {
  skip-at-startup 
}
prefer-no-csd 
cursor {
  xcursor-theme "Adwaita"
}
layer-rule {
  match namespace="^wallpaper$"
  place-within-backdrop true
}
screenshot-path "~/Afbeeldingen/Schermafdrukken/screen-%Y-%m-%d-%H-%M-%S.png"
animations {
  slowdown 1.0
}
binds {
  Mod+K hotkey-overlay-title="Close focused window" { close-window; }
  Mod+O hotkey-overlay-title="Toggle workspace overview layout" { toggle-overview; }
  Mod+question hotkey-overlay-title="Show hotkey cheatsheet overlay" { show-hotkey-overlay; }
  XF86AudioRaiseVolume hotkey-overlay-title="Volume +5%" allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"; }
  XF86AudioLowerVolume hotkey-overlay-title="Volume -5%" allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
  XF86AudioMute hotkey-overlay-title="Mute/Unmute toggle" allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
  XF86AudioPlay hotkey-overlay-title="Media player play/pause toggle" allow-when-locked=true { spawn-sh "playerctl play-pause"; }
  XF86AudioStop hotkey-overlay-title="Media player stop" allow-when-locked=true { spawn-sh "playerctl stop"; }
  XF86AudioPrev hotkey-overlay-title="Media player previous track" allow-when-locked=true { spawn-sh "playerctl previous"; }
  XF86AudioNext hotkey-overlay-title="Media player next track" allow-when-locked=true { spawn-sh "playerctl next"; }
  XF86MonBrightnessUp hotkey-overlay-title="Monitor brightness up" allow-when-locked=true { spawn-sh "brightnessctl set +5%"; }
  XF86MonBrightnessDown hotkey-overlay-title="Monitor brightness down" allow-when-locked=true { spawn-sh "brightnessctl set 5%-"; }
  Mod+Shift+Q hotkey-overlay-title="Quit window session safely" { quit; }
  Ctrl+Alt+Delete hotkey-overlay-title="Force terminate shell context" { quit; }
  Mod+Ctrl+E hotkey-overlay-title="Restart core Emacs server process" { spawn-sh "bash ~/.local/bin/user-script-restart-emacs.bash"; }
  Mod+T hotkey-overlay-title="Launch Alacritty terminal emulator" { spawn-sh "alacritty"; }
  Mod+E hotkey-overlay-title="Launch Emacs window manager frame" { spawn-sh "emacsclient -c"; }
  Mod+Shift+T hotkey-overlay-title="Open sandboxed Eshell instance window" { spawn-sh "emacsclient -ce '(eshell \"new\")(rename-buffer (concat \"*eshell: \" (float-time) \"*\"))'"; }
  Mod+Shift+E hotkey-overlay-title="Open fallback terminal-mode Emacs client" { spawn-sh "alacritty -o 'keyboard.bindings=[]' -e emacsclient -t"; }
  Mod+I hotkey-overlay-title="Launch primary Web Browser instance" { spawn-sh "google-chrome"; }
  Mod+Shift+I hotkey-overlay-title="Launch Nyxt programmatic web keyboard framework" { spawn-sh "flatpak run engineer.atlas.Nyxt"; }
  Mod+B hotkey-overlay-title="Launch Nautilus visual file hierarchy explorer" { spawn-sh "nautilus -w"; }
  Mod+M hotkey-overlay-title="Launch music player RMPC in terminal" { spawn-sh "kitty -e 'rmpc'"; }
  Mod+slash hotkey-overlay-title="Open Rofi system program application menu" { spawn-sh "pkill rofi || rofi -show drun"; }
  Mod+Shift+B hotkey-overlay-title="Shuffle system decorative background canvas" { spawn-sh "bash ~/.local/bin/user-script-set-random-wallpaper"; }
  Mod+space hotkey-overlay-title="Toggle selected layout floating mode status" { toggle-window-floating; }
  Mod+F hotkey-overlay-title="Maximize width expansion of current column block" { maximize-column; }
  Mod+Shift+F hotkey-overlay-title="Force total hardware screen full-display context" { fullscreen-window; }
  Mod+C hotkey-overlay-title="Anchor active viewport targeted column horizontally" { center-column; }
  Mod+Comma hotkey-overlay-title="Merge adjacent floating frame windows inwards" { consume-window-into-column; }
  Mod+Period hotkey-overlay-title="Extract bounded element node into solo row layout" { expel-window-from-column; }
  Mod+R hotkey-overlay-title="Cycle across native desktop column geometry templates" { switch-preset-column-width; }
  Mod+Escape hotkey-overlay-title="Inhibit active workspace application intercepts" allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
  Mod+L hotkey-overlay-title="Lock environment layout layer instantly" { spawn-sh "swaylock --image /home/joe/.config/digital-art-dreams/wallpapers/space/1.jpg --indicator-idle-visible --scaling fill --indicator-radius 120 --indicator-thickness 10 --ring-color cba6f7 --key-hl-color f5c2e7 --line-color 00000000 --inside-color 1e1e2e88 --separator-color 00000000 --text-color cdd6f4"; }
  Mod+Shift+slash hotkey-overlay-title="Show hotkey cheatsheet overlay fallback alternative" { show-hotkey-overlay; }
  Mod+S hotkey-overlay-title="Capture region screenshot snip clipping" { screenshot; }
  Mod+Shift+S hotkey-overlay-title="Capture complete active monitor interface screenshot" { screenshot-screen; }
  Ctrl+Alt+S hotkey-overlay-title="Capture standalone program window focus context" { screenshot-window; }
  Mod+Shift+G hotkey-overlay-title="Toggle region GIF recording" { spawn-sh "bash ~/.local/bin/gif-record"; }
  Mod+Left hotkey-overlay-title="Focus element columns to the left" { focus-column-left; }
  Mod+Right hotkey-overlay-title="Focus element columns to the right" { focus-column-right; }
  Mod+Down hotkey-overlay-title="Shift active item viewport downstream" { focus-window-down; }
  Mod+Up hotkey-overlay-title="Shift active item viewport upstream" { focus-window-up; }
  Mod+Shift+Left hotkey-overlay-title="Move focused column leftwards layout track" { move-column-left; }
  Mod+Shift+Right hotkey-overlay-title="Move focused column rightwards layout track" { move-column-right; }
  Mod+Shift+Down hotkey-overlay-title="Move target item structural placement down row" { move-window-down; }
  Mod+Shift+Up hotkey-overlay-title="Move target item structural placement up row" { move-window-up; }
  Ctrl+Alt+Left hotkey-overlay-title="Focus display surface mapping leftwards" { focus-monitor-left; }
  Ctrl+Alt+Down hotkey-overlay-title="Focus display surface mapping downwards" { focus-monitor-down; }
  Ctrl+Alt+Up hotkey-overlay-title="Focus display surface mapping upwards" { focus-monitor-up; }
  Ctrl+Alt+Right hotkey-overlay-title="Focus display surface mapping rightwards" { focus-monitor-right; }
  Ctrl+Alt+Shift+Left hotkey-overlay-title="Migrate selected elements array leftward display" { move-column-to-monitor-left; }
  Ctrl+Alt+Shift+Down hotkey-overlay-title="Migrate selected elements array downward display" { move-column-to-monitor-down; }
  Ctrl+Alt+Shift+Up hotkey-overlay-title="Migrate selected elements array upward display" { move-column-to-monitor-up; }
  Ctrl+Alt+Shift+Right hotkey-overlay-title="Migrate selected elements array rightward display" { move-column-to-monitor-right; }
  Mod+Page_Down hotkey-overlay-title="Navigate context view downstream layer" { focus-workspace-down; }
  Mod+Page_Up hotkey-overlay-title="Navigate context view upstream layer" { focus-workspace-up; }
  Mod+Shift+Page_Down hotkey-overlay-title="Migrate target frame collections downstream layout" { move-column-to-workspace-down; }
  Mod+Shift+Page_Up hotkey-overlay-title="Migrate target frame collections upstream layout" { move-column-to-workspace-up; }
  Mod+Minus hotkey-overlay-title="Shrink column layout boundary size (-10%)" { set-column-width "-10%"; }
  Mod+Equal hotkey-overlay-title="Expand column layout boundary size (+10%)" { set-column-width "+10%"; }
  Mod+Shift+Minus hotkey-overlay-title="Shrink window layout vertical geometry (-10%)" { set-window-height "-10%"; }
  Mod+Shift+Equal hotkey-overlay-title="Expand window layout vertical geometry (+10%)" { set-window-height "+10%"; }
}
window-rule {
  match app-id="cairo-dock"
  open-floating true
  open-focused false
  focus-ring {
    off 
  }
  border {
    off 
  }
}
window-rule {
  geometry-corner-radius 10
  clip-to-geometry true
  draw-border-with-background false
  default-column-width {
    proportion 0.6666666
  }
}
spawn-sh-at-startup "niri msg output eDP-1 scale 1.2"
spawn-sh-at-startup "cd /home/joe/Hacking/lambdock && maak run"
spawn-sh-at-startup "mako"
spawn-sh-at-startup "waybar"
spawn-sh-at-startup "bash ~/.local/bin/user-script-set-random-wallpaper"
spawn-sh-at-startup "alacritty --daemon"
spawn-sh-at-startup "pkill lambdock || true; lambdock || true"
spawn-sh-at-startup "emacs --daemon"
spawn-sh-at-startup "podman system service --time=0 unix:///tmp/podman.sock"
spawn-sh-at-startup "xdg-user-dirs-update"
spawn-sh-at-startup "nm-applet"
spawn-sh-at-startup "blueman-applet"
spawn-sh-at-startup "sudo warp-svc"
spawn-sh-at-startup "warp-taskbar"
spawn-sh-at-startup "flatpak run com.onepassword.OnePassword --silent"
spawn-sh-at-startup "fyi \"Welcome to the Heks-Linux power user session\" \"Enter and explore, for the cosmos of computation is yours to command.\""
spawn-sh-at-startup "bash ~/.local/bin/write-gtk-dconf-settings"
spawn-sh-at-startup "bash ~/.local/bin/write-heks-dconf-settings"