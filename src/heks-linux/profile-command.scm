;;; Commentary:
;;
;; `heks-profile': the command that makes a profile a file a person points at.
;;
;; The loader in @code{(heks-linux profile)} answers what a profile means; this
;; answers which one, and writes the one line that changes the answer: the copy
;; of a profile at @file{$XDG_CONFIG_HOME/heks-linux/profile.scm}.  Because that
;; file is the profile itself rather than a reference to one, `diff' and `git
;; diff' are the same tool, and a machine's description can be branched,
;; published and merged like any other file.
;;
;; A separate module from the loader because of the load order: the loader is
;; imported by the prelude, and the prelude is imported by everything this
;; command writes with.  The command is the edge, and edges are allowed to know
;; about both sides.
;;
;;; Code:

(define-module (heks-linux profile-command)
  #:declarative? #t
  #:use-module (ice-9 format)
  #:use-module (ice-9 pretty-print)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:use-module (heks-linux prelude)
  #:use-module (heks-linux profile)
  #:export (profile-show
            profile-use
            profile-diff
            profile-check
            main))

(define (config-home)
  (let ((xdg (getenv "XDG_CONFIG_HOME")))
    (if (and xdg (not (string=? xdg "")))
      xdg
      (format #f "~a/.config" (or (getenv "HOME") "/tmp")))))

(define (active-path)
  (format #f "~a/heks-linux/profile.scm" (config-home)))

(define (read-profile path)
  "Return @var{path}'s data and problems."
  (call-with-values (lambda () (profile-read path))
    (lambda (data problem)
      (values data
              (if problem
                (list problem)
                (if data (profile-validate data) '()))))))

(define (profile-show name)
  "Print the profile called @var{name}, or the active one."
  (let* ((path (if name
                 (let ((candidate (assoc name
                                         (profile-candidates))))
                   (and candidate (cdr candidate)))
                 (active-path))))
    (cond
      [(not path)
       (format (current-error-port) "heks-profile: no profile named ~a~%" name)
       1]
      [(not (file-exists? path))
       (format (current-error-port) "heks-profile: no profile at ~a~%" path)
       1]
      [else
        (call-with-values (lambda () (read-profile path))
          (lambda (data problems)
            (if (pair? problems)
              (begin
                (for-each (lambda (problem)
                            (format (current-error-port)
                                    "heks-profile: ~a~%" problem))
                          problems)
                1)
              (begin
                (pretty-print data)
                0))))])))

(define (profile-use name)
  "Make the profile called @var{name} the one this machine wears."
  (let ((candidate (assoc name (profile-candidates))))
    (cond
      [(not candidate)
       (format (current-error-port)
               "heks-profile: no profile named ~a (try `heks-profile list')~%"
               name)
       1]
      [else
        (call-with-values (lambda () (read-profile (cdr candidate)))
          (lambda (data problems)
            (if (pair? problems)
              (begin
                (for-each (lambda (problem)
                            (format (current-error-port)
                                    "heks-profile: ~a~%" problem))
                          problems)
                1)
              (begin
                ;; The file is the profile, so the write is a
                ;; copy with the canonical banner rather than a
                ;; pointer: a machine's description stays a file
                ;; another machine can read on its own.
                (install-config-file!
                 #:name "profile.scm"
                 #:dir (format #f "~a/heks-linux" (config-home))
                 #:contents
                 (string-append
                  ";; The profile this machine wears.\n"
                  ";; Generated by `heks-profile use "
                  name
                  "'; data, not code.\n\n"
                  (with-output-to-string
                   (lambda ()
                     (pretty-print data)))))
                (format #t "heks-profile: now ~a~%" name)
                0))))])))

(define (profile-diff left right)
  "Print the keys two profiles disagree about."
  (let ((left-path (or (assoc-ref (profile-candidates) left) left))
        (right-path (or (assoc-ref (profile-candidates) right) right)))
    (cond
      [(or (not (file-exists? left-path)) (not (file-exists? right-path)))
       (format (current-error-port) "heks-profile: one of the two is not a file~%")
       1]
      [else
        (call-with-values (lambda () (read-profile left-path))
          (lambda (left-data _left-problems)
            (call-with-values (lambda () (read-profile right-path))
              (lambda (right-data _right-problems)
                (let ((keys (delete-duplicates
                             (append (map car left-data)
                                     (map car right-data)))))
                  (for-each (lambda (key)
                              (let ((a (assoc key left-data))
                                    (b (assoc key right-data)))
                                (unless (equal? a b)
                                  (format #t "~a: ~a -> ~a~%"
                                          key
                                          (if a (cdr a) "(unset)")
                                          (if b (cdr b) "(unset)")))))
                            keys))
                0))))])))

(define (profile-check)
  "Validate the profile in force and say whether a render can use it."
  (let ((path (active-path)))
    (if (not (file-exists? path))
      (begin
        (format #t "heks-profile: no profile in force; the defaults are used~%")
        0)
      (call-with-values (lambda () (read-profile path))
        (lambda (data problems)
          (if (null? problems)
            (begin
              (format #t "heks-profile: ~a is valid (~a parameter~a)~%"
                      path
                      (length data)
                      (if (= (length data) 1) "" "s"))
              0)
            (begin
              (for-each (lambda (problem)
                          (format (current-error-port)
                                  "heks-profile: ~a~%" problem))
                        problems)
              1)))))))

(define (profile-list)
  "Print every profile this machine can choose, marking the one in force."
  (let* ((active (and (file-exists? (active-path))
                   (call-with-values (lambda () (read-profile (active-path)))
                     (lambda (data problems)
                       (and (null? problems) data)))))
         (candidates (profile-candidates)))
    (if (null? candidates)
      (format #t "heks-profile: no profiles; put one in ~a~%"
              (profile-directory))
      (for-each (lambda (candidate)
                  (let ((same? (and active
                                 (call-with-values
                                   (lambda () (read-profile (cdr candidate)))
                                   (lambda (data problems)
                                     (and (null? problems)
                                       (equal? data active)))))))
                    (format #t "~a ~a~%"
                            (if same? "*" " ")
                            (car candidate))))
                candidates))
    0))

(define (usage port)
  (format port "heks-profile - the profile this machine wears

Usage: heks-profile COMMAND [ARGS]

  list                Every profile this machine can choose, active one marked
  show [NAME]         Print one profile's data as an alist
  use NAME            Make NAME the profile in force, and say so
  diff A B            The keys two profiles disagree about
  check               Validate the profile in force without rendering

A profile is data: an alist of parameters, read with `read' and never evaluated.
Overrides are code and still win; `docs/configuration.org' has the difference.
"))

(define (main args)
  "Entry point for @command{heks-profile}; @var{args} is @code{(command-line)}."
  (let ((arguments (cdr args)))
    (cond
      [(null? arguments)
       (usage (current-output-port))
       (exit 2)]
      [(member (car arguments) '("-h" "--help" "help"))
       (usage (current-output-port))
       (exit 0)]
      [else
        (exit
         (case (string->symbol (car arguments))
           [(list) (profile-list)]
           [(show) (profile-show (and (pair? (cdr arguments))
                                   (cadr arguments)))]
           [(use)
            (if (pair? (cdr arguments))
              (profile-use (cadr arguments))
              (begin
                (format (current-error-port) "heks-profile: use needs a name~%")
                2))]
           [(diff)
            (if (and (pair? (cdr arguments)) (pair? (cddr arguments)))
              (profile-diff (cadr arguments) (caddr arguments))
              (begin
                (format (current-error-port) "heks-profile: diff needs two names~%")
                2))]
           [(check) (profile-check)]
           [else
             (format (current-error-port) "heks-profile: unknown command ~a~%"
                     (car arguments))
             (usage (current-error-port))
             2]))])))

;;; profile-command.scm ends here
