;;; Commentary:
;;
;; The commands this project runs against itself, installed beside the dotfiles.
;;
;; `maak audit' works from a checkout and needs the checkout.  A pipeline, a CI
;; job and a bug report want the same answer from anywhere, under the name the
;; documentation uses: `heks-audit', `heks-pins', `heks-update',
;; `heks-describe' and `heks-profile'.  So each is a launcher that finds the
;; source tree, gives Guile the modules, and hands the arguments through.
;;
;; The launcher probes the plain `guile' once and falls back to the pinned
;; manifest shell: a machine that has the collection installed should start in a
;; fifth of a second, and a machine that does not should still start.  The probe
;; is a module load and nothing else - running the command twice to find out
;; whether it works is how an update becomes two updates.  Neither path writes
;; anything: `guix shell' on a realized manifest is a lookup, and
;; `--no-auto-compile' keeps Guile from writing a cache.
;;
;;; Code:

(define-module (heks-linux tools)
  #:declarative? #t
  #:use-module (ice-9 format)
  #:use-module (srfi srfi-1)
  #:use-module (heks-linux prelude)
  #:use-module (heks-linux user-settings)
  #:use-module (scriba scriba)
  #:use-module (scriba auto)
  #:export (heks-tools
            heks-tools-dir
            tool-launcher
            install-heks-tools))

(define s
  (scriba-auto-logger))

;; The five programs, as (NAME MODULE).  `main` is the convention every module
;; here follows: it takes `(command-line)' and exits with its status.
(define heks-tools
  '((audit heks-linux audit)
    (pins heks-linux pins)
    (update heks-linux update)
    (describe heks-linux describe)
    (profile heks-linux profile-command)))

(define heks-tools-dir
  (make-parameter (format #f "~a/.local/bin" (or (getenv "HOME") "/tmp"))))

(define (tool-launcher name module)
  "Return one launcher script for @var{name} in @var{module}."
  (let ((expression (format #f "((@ (~a) main) (command-line))" module))
        (probe (format #f "(use-modules (~a))" module))
        (clone (heks-linux-clone-dir)))
    (string-join
     (list "#!/usr/bin/env bash"
           (format #f "# ====== heks-~a ======" name)
           "# auto-generated by heks-linux, DO NOT EDIT!"
           "#"
           "# Runs the command from the checkout named below, in the pinned"
           "# manifest shell when the machine's own guile does not already"
           "# have this project's modules.  Nothing is written either way."
           "set -eu"
           (format #f "clone=\"${HEKS_LINUX_CLONE:-~a}\"" clone)
           "src=\"$clone/src\""
           "if [ ! -d \"$src/heks-linux\" ]; then"
           (format #f "  echo \"heks-~a: no source tree at $src\" >&2" name)
           "  echo 'Set HEKS_LINUX_CLONE to the checkout.' >&2"
           "  exit 2"
           "fi"
           (format #f "expr=~s" expression)
           ;; The probe loads the module the command lives in; it does not run
           ;; the command, so a failing audit is not run twice.
           (format #f "if guile --no-auto-compile -L \"$src\" -c ~s >/dev/null 2>&1; then"
                   probe)
           "  exec guile --no-auto-compile -L \"$src\" -c \"$expr\" -- \"$@\""
           "fi"
           "exec guix shell -m \"$clone/manifest.scm\" -- guile --no-auto-compile -L \"$src\" -c \"$expr\" -- \"$@\"")
     "\n")))

(define (install-heks-tools)
  "Write the five launchers into @code{heks-tools-dir}, executable.

They are written through the same atomic writer as every dotfile here, so a
launcher being replaced while a pipeline runs it is either the old script or the
new one."
  (log-info s "Installing the heks commands")
  (for-each (lambda (tool)
              (install-config-file! #:name (format #f "heks-~a" (first tool))
                                    #:dir (heks-tools-dir)
                                    #:contents (tool-launcher (first tool)
                                                              (second tool))
                                    #:perms 493))
            heks-tools)
  (log-success s "Installed the heks commands"))

;;; tools.scm ends here
