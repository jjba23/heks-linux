#
# Copied from 'whelk' own tree (`packaging/.../template at v0.53.0`) by this repository, so a build of the
# image and a build of its .deb read one checkout instead of whatever
# upstream is at today.  `maak xbps-build' copies this file into a
# void-packages checkout and builds it there; `maak deb-build' reads the
# same $version, $homepage and $checksum to fetch the archive.
#
# The checksum is the one `sha256sum' gives for the GitHub archive of
# v0.53.0, checked again when this copy was taken; a template cannot hold the
# checksum of the archive that would contain it, so it is refreshed once a
# release is tagged.

pkgname=whelk
version=0.53.0
revision=1
build_style=void
hostmakedepends="cargo pkg-config"
makedepends="gtk4-devel gtk4-layer-shell-devel guile-devel pam-devel"
checkdepends="xorg-server-xvfb dbus"
depends="gtk4 gtk4-layer-shell guile cava pam wtype curl hicolor-icon-theme"
short_desc="Wayland shell with bars and launcher, configured in Guile Scheme"
maintainer="Josep Bigorra <jjbigorra@gmail.com>"
license="MIT"
homepage="https://github.com/jjba23/whelk"
distfiles="${homepage}/archive/refs/tags/v${version}.tar.gz"
checksum=2a91775a4b76e5d997f516130eac37211903f13e92a73d09cdf2d027819b08ff

do_build() {
	cargo build --release --locked --offline --bin whelk
}

do_check() {
	# GTK tests need a display even when they never map a window, and GLib
	# must not write to the build user's home.
	export HOME="$wrksrc"
	export XDG_RUNTIME_DIR="$wrksrc"
	export GTK_A11Y=test
	export GDK_BACKEND=x11
	export GSK_RENDERER=cairo
	xvfb-run -a cargo test --workspace --locked --offline
}

do_install() {
	cargo xtask install --prefix=/usr --destdir="${DESTDIR}" --no-build
	vlicense LICENSE
}
