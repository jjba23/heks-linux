;;; Commentary:
;;;
;;; The development shell: Guile, the test suite and the documentation
;;; tooling.  The collection's packages come from the jointhefreeworld
;;; channel pinned in channels.scm, not from copies defined here, so a
;;; version is bumped once, in the channel, and every `guix shell -m
;;; manifest.scm' and `guix time-machine --channels=channels.scm' run picks
;;; it up.
;;;
;;; The channel modules are imported with a prefix because Guix itself still
;;; carries older guile-veritas, guile-scriba and maak bindings; the prefix
;;; makes it explicit which release the shell gets instead of leaving it to
;;; import order.

(use-modules (guix packages)
             (guix profiles)
             (gnu packages)
             (gnu packages base)
             (gnu packages bash)
             (gnu packages curl)
             (gnu packages emacs)
             (gnu packages gawk)
             (gnu packages gettext)
             (gnu packages gnupg)
             (gnu packages guile)
             (gnu packages nss)
             (gnu packages guile-xyz)
             (gnu packages texinfo)
             (gnu packages xml)
             ((jointhefreeworld packages guile)
              #:prefix jtf:)
             ((jointhefreeworld packages applications)
              #:prefix jtf:))

(packages->manifest (list guile-3.0-latest
                          ;; The capture program the tests run is a bash one.
                          bash
                          guile-json-4
                          (specification->package "texinfo")
                          ;; The Emacs this profile puts on the PATH, which is the
                          ;; one the compositor starts as a daemon (`emacs
                          ;; --daemon' in niri's startup list).  It has to be a
                          ;; build with a toolkit: `emacs-no-x' can only create
                          ;; terminal frames, so `emacsclient -c' drew nothing.
                          emacs-pgtk
                          coreutils
                          ;; `maak install-eca' fetches the eca-cli release with
                          ;; these two and unpacks it with tar.
                          curl
                          tar
                          ;; curl verifies the release download against this
                          ;; bundle; without it the shell has no trust store.
                          nss-certs
                          guile-gcrypt
                          jtf:guile-veritas
                          ;; The API reference is generated by dokgen, which
                          ;; the jointhefreeworld channel pinned in
                          ;; channels.scm carries.
                          (specification->package "guile-dokgen")
                          jtf:guile-scriba
                          glibc-locales
                          ;; `getent' is the user database the specs ask for a
                          ;; home and an owner, and `xmllint' is what the
                          ;; validation specs use to check a rendered file.  A
                          ;; container without them fails tests the code does
                          ;; not fail.
                          glibc
                          libxml2
                          ;; The fake disk the installer specs run against is a
                          ;; shell harness, and its stubs are written in the
                          ;; tools a shell script reaches for: `parted' is
                          ;; modelled with awk, the medium's service files are
                          ;; listed with grep, and a sudoers line is edited with
                          ;; sed.  Without all three the harness stops on its
                          ;; first missing tool and the install run fails for a
                          ;; reason the installer has nothing to do with.
                          gawk
                          grep
                          sed
                          jtf:maak
                          jtf:sift
                          ;; `maak install-locale' compiles po/*.po into the
                          ;; user's locale directory with msgfmt, and the tests
                          ;; compile the catalogue the same way.
                          gnu-gettext))
